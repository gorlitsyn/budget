# Скопируйте в deploy/money.env и заполните. Секретов здесь нет: сессии и passkeys живут в БД.

# Passkeys привязаны к домену. Сменить RP_ID после первой регистрации = все passkeys недействительны.
RP_ID=budget.example.com
ORIGIN=https://budget.example.com
RP_NAME=Бюджет

# Часовой пояс: по нему определяется смена месяца, после которой план прошлого месяца фиксируется.
TZ=UTC

SESSION_DAYS=90
INVITE_DAYS=7
