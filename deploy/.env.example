# Скопируйте в deploy/.env и заполните. Файл не попадает в git.

# Каталог с базой на сервере. Владелец — uid 1000. По умолчанию ./data в корне репозитория.
MONEY_DATA=../data

# Вариант 1: свой HTTPS-прокси (nginx, Caddy, Traefik) ходит на этот порт на 127.0.0.1.
MONEY_PORT=8080

# Вариант 2: caddy-docker-proxy. Заполните оба значения и подключите docker-compose.caddy-proxy.yml.
# MONEY_DOMAIN=budget.example.com
# MONEY_PROXY_NETWORK=caddy

# Только для scripts/deploy.sh, backup.sh и invite.sh (запуск с вашего компьютера по SSH).
# MONEY_SSH=user@server
# MONEY_URL=https://budget.example.com
# MONEY_DIR=/opt/docker/money
# MONEY_BACKUP_DIR=/home/you/money-backups
